# Server key from your ER:LC private server: Settings -> search "API key".
# NEVER commit the real value. Set it in Vercel/host env vars only.
ERLC_SERVER_KEY=

# Only for registered public apps (multi-server). Leave empty for a single server.
ERLC_GLOBAL_KEY=

# Password for the dashboard (HTTP basic auth, any username). Required in production.
DASHBOARD_PASSWORD=

# Map units -> pixels on the 5355px official map. Calibrate if markers look off.
NEXT_PUBLIC_MAP_PX_PER_UNIT=1
